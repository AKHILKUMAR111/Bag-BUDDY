<%- include('../partials/header') %>

  <div class="min-h-screen flex flex-col">
    <div class="container px-10 py-20 flex flex-grow">
      <div class="w-[25%] flex h-screen flex-col items-start">
        <div class="flex flex-col">
          <a class="block w-fit mb-2" href="">All Products</a>
          <a class="block w-fit mb-2" href="">Create New Product</a>
        </div>
      </div>
      <main class="w-3/4 bg-white p-8 shadow ml-4">
        <h2 class="text-xl font-bold mb-4">Create New Product</h2>


        <form id="requestForm" action="/products/createproduct/admin"method="POST" enctype="multipart/form-data" class="space-y-4">

    <!-- Existing Fields -->
    <input type="text" name="name" placeholder="Product Name" required class="w-full p-3 border border-gray-300 rounded-lg" />
    <input type="number" name="price" placeholder="Price" required class="w-full p-3 border border-gray-300 rounded-lg" />
    <input type="number" name="discount" placeholder="Discount (%)" class="w-full p-3 border border-gray-300 rounded-lg" />
    <input type="text" name="bgColor" placeholder="Background Color (e.g., #f3f4f6)" class="w-full p-3 border border-gray-300 rounded-lg" />
    <input type="text" name="panelColor" placeholder="Panel Color" class="w-full p-3 border border-gray-300 rounded-lg" />
    <input type="text" name="textColor" placeholder="Text Color" class="w-full p-3 border border-gray-300 rounded-lg" />

    <!-- 🆕 New Fields -->
    <input type="text" name="brand" placeholder="Brand (e.g., Nike)" class="w-full p-3 border border-gray-300 rounded-lg" />
    <input type="text" name="category" placeholder="Category (e.g., Duffle Bag)" class="w-full p-3 border border-gray-300 rounded-lg" />
    <textarea name="description" placeholder="Brief product description" class="w-full p-3 border border-gray-300 rounded-lg"></textarea>
    <input type="text" name="tags" placeholder="Tags (comma-separated, e.g., durable, travel)" class="w-full p-3 border border-gray-300 rounded-lg" />

    <!-- 🖼️ Image Upload -->
    <label class="block text-sm font-medium text-gray-700">Product Image</label>
    <input type="file" name="image" accept="image/*" required class="w-full p-3 border border-gray-300 rounded-lg" />

    <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">Submit Request</button>
  </form>
      </main>
    </div>
  </div>

  <%- include('../partials/footer') %>