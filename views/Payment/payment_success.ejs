<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Payment Success – Bag Buddy</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-green-100 via-white to-green-50 min-h-screen flex items-center justify-center font-sans">

    <div class="bg-white p-10 rounded-2xl shadow-2xl w-full max-w-lg text-center border border-green-200">
        <!-- Success Icon -->
        <div class="text-green-600 text-5xl mb-4">
            ✅
        </div>

        <!-- Heading -->
        <h2 class="text-3xl font-extrabold text-green-700 mb-2">Payment Successful</h2>
        <p class="text-lg text-gray-700 mb-1">Thank you for shopping with <span class="font-semibold text-green-800">Bag Buddy</span>!</p>
        <p class="text-sm text-gray-600 mb-6">Your order has been placed using: <span class="font-medium"><%= method %></span></p>

        <!-- Continue Button -->
        <a href="/shop" class="inline-block bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-xl shadow-md transition duration-200">
            Continue Shopping
        </a>
    </div>

</body>
</html>
