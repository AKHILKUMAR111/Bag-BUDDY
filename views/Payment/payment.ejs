<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Bag Buddy - Checkout</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-green-100 via-white to-green-50 font-sans">

    <div class="w-full min-h-screen flex items-center justify-center">
        <div class="bg-white p-10 rounded-2xl shadow-2xl w-full max-w-xl text-center border border-green-200">
            <!-- Page Title -->
            <h2 class="text-3xl font-extrabold text-green-700 mb-3 tracking-wide">Secure Checkout</h2>
            <p class="text-gray-600 mb-6">You're just one step away from completing your purchase!</p>

            <!-- Total Amount -->
            <div class="bg-green-50 border border-green-200 p-6 rounded-xl shadow-sm mb-6">
                <h3 class="text-xl font-semibold text-gray-700">Total Amount Payable</h3>
                <p class="text-3xl text-green-600 font-extrabold mt-2">₹ <%= bill %></p>
            </div>

            <!-- Razorpay Payment Form -->
            <form action="/payment/process-payment" method="POST">
                <input type="hidden" name="amount" value="<%= bill %>">
                <input type="hidden" name="paymentMethod" value="razorpay">

                <button type="submit" class="w-full py-3 bg-green-600 hover:bg-green-700 text-white text-lg font-bold rounded-xl transition-all duration-200 shadow-md hover:shadow-lg">
                    Pay with Razorpay
                </button>
            </form>

            <p class="text-sm text-gray-400 mt-6">You’ll be redirected to Razorpay to complete your payment.</p>
        </div>
    </div>

</body>
</html>
