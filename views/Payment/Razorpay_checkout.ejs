<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Bag Buddy – Razorpay Checkout</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-green-100 via-white to-green-50 flex items-center justify-center min-h-screen font-sans">

    <div class="bg-white shadow-xl rounded-2xl p-10 max-w-md w-full text-center border border-green-200">
        <h2 class="text-3xl font-extrabold text-green-700 mb-4">Ready to Pay</h2>
        <p class="text-gray-600 mb-6">Click the button below to complete your secure payment.</p>

        <!-- Razorpay Pay Button -->
        <button id="rzp-button" class="bg-green-600 hover:bg-green-700 text-white text-lg font-bold py-3 px-8 rounded-xl shadow-md transition duration-200">
            Pay ₹ <%= amount / 100 %> Now
        </button>

        <p class="text-sm text-gray-400 mt-6">You’ll be redirected to Razorpay’s secure gateway.</p>
    </div>

    <!-- Razorpay Script -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        const options = {
            key: "<%= keyId %>",
            amount: "<%= amount %>",
            currency: "INR",
            name: "Bag Buddy",
            description: "Order Payment",
            image: "/logo.png",
            order_id: "<%= orderId %>",
            handler: function (response) {
                window.location.href = "/payment/payment-success?method=online";
            },
            prefill: {
                name: "Akhil Kumar",
                email: "akhil@example.com",
                contact: "9000000000"
            },
            theme: {
                color: "#38a169"
            }
        };

        const rzp = new Razorpay(options);
        document.getElementById('rzp-button').onclick = function () {
            rzp.open();
        };
    </script>

</body>
</html>
